<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical">

    <FrameLayout android:layout_width="match_parent" android:layout_height="52dp" android:paddingHorizontal="12dp">
        <ImageView android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="start|center_vertical" android:padding="8dp"
            android:src="@drawable/ic_back" android:contentDescription="Retour"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="Ma trousse personnelle"
            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
    </FrameLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="96dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_margin="16dp" android:text="🧴 Mes produits"
                    android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvEmptyItems" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp" android:text="Votre trousse est vide. Ajoutez un produit (scan IA ou saisie manuelle)."
                    android:textColor="@color/text_secondary" android:textSize="12sp" android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvItems" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_margin="16dp" android:text="✨ Recommandations pour vous"
                    android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvEmptyRecs" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp" android:text="Ajoutez des produits à votre trousse pour recevoir des suggestions de soins complémentaires."
                    android:textColor="@color/text_secondary" android:textSize="12sp" android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecs" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_margin="16dp" android:text="Ajouter"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary" app:icon="@drawable/ic_add" app:iconTint="@color/white"/>
    </FrameLayout>
</LinearLayout>
