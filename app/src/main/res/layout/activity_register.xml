<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- Barre du haut -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="40dp">
            <ImageView
                android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="start|center_vertical" android:padding="8dp"
                android:src="@drawable/ic_back" android:contentDescription="@string/cancel"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="@string/inscription"
                android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
            <ImageView
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_avatar" android:padding="6dp"
                android:src="@drawable/ic_person" android:importantForAccessibility="no"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_badge"
            android:paddingHorizontal="8dp" android:paddingVertical="3dp"
            android:text="@string/assistant_version" android:textColor="@color/primary"
            android:textSize="9sp" android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/create_account_title"
            android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/create_account_sub"
            android:textColor="@color/text_secondary" android:textSize="12sp"/>

        <!-- Choix du rôle -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:baselineAligned="false">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardClient"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/white" app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:strokeColor="@color/primary" app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_person" android:importantForAccessibility="no"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/i_am_client"
                        android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/client_sub" android:textColor="@color/text_secondary" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPharmacien"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/white" app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:strokeColor="@color/stroke" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_shield" android:importantForAccessibility="no"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/i_am_pharmacist"
                        android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/pharmacist_sub" android:textColor="@color/text_secondary" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoleHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/bg_hint" android:padding="10dp"
            android:text="@string/hint_client" android:textColor="@color/primary" android:textSize="11sp"/>

        <!-- Champs -->
        <TextView style="@style/ParaCare.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_fullname"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName" style="@style/ParaCare.Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" app:startIconDrawable="@drawable/ic_person">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/hint_fullname" android:inputType="textPersonName|textCapWords" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/ParaCare.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/label_email_req"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail" style="@style/ParaCare.Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" app:startIconDrawable="@drawable/ic_mail">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/hint_email_reg" android:inputType="textEmailAddress" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center_vertical">
            <TextView style="@style/ParaCare.Label" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/label_phone"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/sms_alerts" android:textColor="@color/primary"
                android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone" style="@style/ParaCare.Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" app:startIconDrawable="@drawable/ic_phone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/hint_phone" android:inputType="phone" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/ParaCare.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/label_password_req"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword" style="@style/ParaCare.Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" app:startIconDrawable="@drawable/ic_lock"
            app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/hint_password_min" android:inputType="textPassword" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/strengthBar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:max="3" android:progress="0"
            app:trackThickness="4dp" app:trackColor="@color/stroke" app:indicatorColor="@color/primary"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/security" android:textColor="@color/text_secondary" android:textSize="10sp"/>
            <TextView android:id="@+id/tvStrength" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/strength_none" android:textColor="@color/text_secondary"
                android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView style="@style/ParaCare.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/label_confirm"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirm" style="@style/ParaCare.Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" app:startIconDrawable="@drawable/ic_lock"
            app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirm" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/hint_confirm" android:inputType="textPassword" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cbTerms" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/accept_terms" android:textSize="11sp"
            android:textColor="@color/text_secondary" android:buttonTint="@color/primary"/>
        <CheckBox
            android:id="@+id/cbAlerts" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:checked="true" android:text="@string/accept_alerts" android:textSize="11sp"
            android:textColor="@color/text_secondary" android:buttonTint="@color/primary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreate" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" android:text="@string/create_my_account" android:textStyle="bold"
            app:cornerRadius="14dp" app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_account" app:iconTint="@color/white" app:iconGravity="textStart"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/already_account" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <TextView android:id="@+id/tvLogin" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:padding="4dp" android:text="@string/sign_in"
                android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill" android:paddingHorizontal="12dp" android:paddingVertical="6dp"
            android:text="@string/data_hosted" android:textColor="@color/text_secondary" android:textSize="10sp"/>
    </LinearLayout>
</ScrollView>
