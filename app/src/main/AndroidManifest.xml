<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ParaCareApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParaCare">

        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.RegisterActivity" android:exported="false" />

        <!-- Client -->
        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.TrousseActivity" android:exported="false" />
        <activity android:name=".ui.ProductsActivity" android:exported="false" />
        <activity android:name=".ui.MyOrdersActivity" android:exported="false" />

        <!-- Pharmacien -->
        <activity android:name=".ui.PharmacistActivity" android:exported="false" />
        <activity android:name=".ui.AddProductActivity" android:exported="false" />
        <activity android:name=".ui.StockListActivity" android:exported="false" />
        <activity android:name=".ui.PharmacistOrdersActivity" android:exported="false" />
        <activity android:name=".ui.ExpiryDashboardActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
